# DeepSeek API（Anthropic 兼容接口）
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-v4-pro

# 向量数据库
# 本地 Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 或 Zilliz Cloud（同时设置 USER / PASSWORD）
# MILVUS_HOST=xxx.serverless.aws-eu-central-1.cloud.zilliz.com
# MILVUS_PORT=443
# MILVUS_USER=your-user
# MILVUS_PASSWORD=your-password
MILVUS_COLLECTION=agentic_rag_docs

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-m3

# ArcMap MCP（stdio，使用 arcmap-mcp 自己的 Python 3 虚拟环境）
ARCMAP_MCP_PYTHON=C:\path\to\arcmap-mcp\venv\Scripts\python.exe
ARCMAP_MCP_SERVER=C:\path\to\arcmap-mcp\src\arcmap_mcp_server.py

# Agent 最多执行几轮工具调用
AGENT_MAX_TOOL_ROUNDS=6
# 单个工具结果超过该字符数就落盘
TOOL_RESULT_MAX_CHARS=50000
